## 1. Introduction

A bank wants to store the last 10 transactions of each savings account so that customers can view them through an ATM mini-statement.

For this purpose, a class named `SavingsAccount` is created. It contains the account number, balance, an array of 10 transactions and a transaction count.

The older transactions are removed when new transactions are added beyond the limit.

## 2. Class Specification

The class contains the following private data members:

- `accountNumber` – Stores the account number.
- `balance` – Stores the current account balance.
- `transactions[10]` – Stores the last 10 transactions.
- `count` – Keeps track of the number of stored transactions.

The public member functions are:

- `deposit()` – Adds money to the account.
- `withdraw()` – Withdraws money from the account.
- `miniStatement()` – Displays the last 10 transactions.

## 3. C++ Program

```cpp
#include <iostream>
using namespace std;

class SavingsAccount
{
private:
    int accountNumber;
    double balance;
    double transactions[10];
    int count;

    // Defined inside the class
    void addTransaction(double amount)
    {
        if (count < 10)
        {
            transactions[count] = amount;
            count++;
        }
        else
        {
            for (int i = 0; i < 9; i++)
                transactions[i] = transactions[i + 1];

            transactions[9] = amount;
        }
    }

public:
    SavingsAccount(int acc, double bal)
    {
        accountNumber = acc;
        balance = bal;
        count = 0;
    }

    // Function declarations
    void deposit(double amount);
    void withdraw(double amount);
    void miniStatement();
};

// Defined outside the class
void SavingsAccount::deposit(double amount)
{
    if (amount > 0)
    {
        balance += amount;
        addTransaction(amount);
        cout << "Deposit successful\n";
    }
    else
        cout << "Invalid deposit\n";
}

void SavingsAccount::withdraw(double amount)
{
    if (amount > 0 && amount <= balance)
    {
        balance -= amount;
        addTransaction(-amount);
        cout << "Withdrawal successful\n";
    }
    else
        cout << "Invalid withdrawal\n";
}

void SavingsAccount::miniStatement()
{
    cout << "\nAccount Number: " << accountNumber << '\n';
    cout << "Current Balance: Rs " << balance << '\n';
    cout << "Last Transactions:\n";

    for (int i = 0; i < count; i++)
        cout << transactions[i] << '\n';
}

int main()
{
    SavingsAccount account(101, 5000);

    account.deposit(1000);
    account.withdraw(500);
    account.deposit(2000);
    account.withdraw(300);

    account.miniStatement();

    return 0;
}
```

